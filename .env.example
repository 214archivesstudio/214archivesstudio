# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=cloud_name
# Cloudinary unsigned upload preset for the admin upload widget.
# Create one in Cloudinary Console → Settings → Upload → Add upload preset (Mode: Unsigned).
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=unsigned_preset

# Site (used for magic link redirects — must match Supabase Dashboard Site URL)
# Dev: http://localhost:3001
# Prod: https://214archives.studio
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase — public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase — server-only (NEVER commit, NEVER expose to client)
# Used by: scripts/seed-from-csv.ts, scripts/sync-from-supabase.ts (CI), admin server actions
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# GitHub Actions trigger for "Publish" (server-only)
# Personal access token with workflow:write scope on this repo.
GITHUB_DISPATCH_TOKEN=ghp_xxx
GITHUB_DISPATCH_REPO=214archivesstudio/214archivesstudio  # owner/repo
